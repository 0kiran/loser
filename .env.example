# Server-only. Add in Vercel Project Settings → Environment Variables.
# For local development, copy this file to .env.local. Do not use REACT_APP_ prefixes.
TWITCH_USER_LOGIN=kkiran
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Initial refresh token from your own user:read:follows authorization.
TWITCH_REFRESH_TOKEN=
# Stores rotated Twitch tokens between serverless invocations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: enables the recent posts panel and /api/feed?source=tweets&format=rss.
X_BEARER_TOKEN=
